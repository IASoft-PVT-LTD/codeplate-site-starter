---
// Home: the closing call to action with the waitlist form. The id "waitlist"
// is what the header button and the hero link to (/#waitlist).
import { cta } from '../../data/home';
import SubscribeForm from '../SubscribeForm.astro';
---

<section id="waitlist" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6" aria-labelledby="waitlist-title">
  <div class="rounded-(--radius-card) border border-line bg-paper px-6 py-12 text-center sm:px-12">
    <h2 id="waitlist-title" class="text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">{cta.title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-ink-soft">{cta.text}</p>
    <div class="mx-auto mt-8 max-w-lg text-left">
      <SubscribeForm kind="waitlist" />
    </div>
  </div>
</section>
