---
// Home: the features grid (src/data/home.ts `features`).
import { features, featuresTitle } from '../../data/home';
import Icon from '../Icon.astro';
---

<section id="features" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6" aria-labelledby="features-title">
  <h2 id="features-title" class="text-center text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">{featuresTitle}</h2>
  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((f) => (
        <div class="rounded-(--radius-card) border border-line bg-paper p-6">
          <span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-soft text-brand">
            <Icon name={f.icon} />
          </span>
          <h3 class="mt-4 text-lg font-bold">{f.title}</h3>
          <p class="mt-2 text-ink-soft">{f.text}</p>
        </div>
      ))
    }
  </div>
</section>
