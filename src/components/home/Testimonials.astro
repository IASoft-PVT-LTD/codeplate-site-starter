---
// Home: quotes (src/data/home.ts `testimonials`). Use real quotes, with permission.
import { testimonials } from '../../data/home';
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="testimonials-title">
  <h2 id="testimonials-title" class="text-center text-3xl font-extrabold tracking-tight sm:text-4xl">{testimonials.title}</h2>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      testimonials.items.map((t) => (
        <figure class="flex flex-col rounded-(--radius-card) border border-line bg-paper p-6">
          <blockquote class="flex-1 text-lg">“{t.quote}”</blockquote>
          <figcaption class="mt-6 text-sm">
            <span class="block font-semibold">{t.name}</span>
            <span class="text-ink-soft">{t.role}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
