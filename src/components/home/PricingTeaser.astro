---
// Home: a short pricing pitch linking to /pricing/ (src/data/home.ts `pricingTeaser`).
import { pricingTeaser } from '../../data/home';
import Icon from '../Icon.astro';
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="flex flex-col items-start justify-between gap-6 rounded-(--radius-card) border border-line bg-brand-soft p-8 sm:flex-row sm:items-center sm:p-10">
    <div>
      <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">{pricingTeaser.title}</h2>
      <p class="mt-2 text-ink">{pricingTeaser.text}</p>
    </div>
    <a href={pricingTeaser.link.href} class="inline-flex shrink-0 items-center gap-2 rounded-full bg-brand px-6 py-3 font-semibold text-on-brand hover:bg-brand-strong">
      {pricingTeaser.link.label}
      <Icon name="arrow" size={18} />
    </a>
  </div>
</section>
