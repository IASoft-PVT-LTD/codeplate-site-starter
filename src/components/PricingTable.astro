---
// The plans from src/data/pricing.ts as cards.
import { plans } from '../data/pricing';
import Icon from './Icon.astro';
---

<div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 lg:grid-cols-3">
  {
    plans.map((p) => (
      <section class:list={['flex flex-col rounded-(--radius-card) border bg-paper p-6', p.highlight ? 'border-brand shadow-lg ring-1 ring-brand' : 'border-line']} aria-labelledby={`plan-${p.name}`}>
        <div class="flex items-center justify-between gap-2">
          <h2 id={`plan-${p.name}`} class="text-lg font-bold">{p.name}</h2>
          {p.highlight && <span class="rounded-full bg-brand-soft px-3 py-1 text-xs font-semibold text-brand">Most popular</span>}
        </div>
        <p class="mt-2 text-sm text-ink-soft">{p.blurb}</p>
        <p class="mt-6">
          <span class="text-4xl font-extrabold tracking-tight">{p.price}</span>
          <span class="ml-1 text-sm text-ink-soft">{p.period}</span>
        </p>
        <ul class="mt-6 flex-1 space-y-3 text-sm">
          {p.features.map((f) => (
            <li class="flex gap-2">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-brand" />
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <a href={p.cta.href} class:list={['mt-8 block rounded-full px-5 py-3 text-center font-semibold', p.highlight ? 'bg-brand text-on-brand hover:bg-brand-strong' : 'border border-line text-ink hover:border-brand hover:text-brand']}>
          {p.cta.label}
        </a>
      </section>
    ))
  }
</div>
