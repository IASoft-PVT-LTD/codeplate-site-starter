---
// Site header: logo, navigation (site.nav), theme toggle and the call to action.
// On phones the links fold into a "Menu" disclosure (no JavaScript needed).
import { site } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/' && path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href="/" class="rounded-lg" aria-label={`${site.name} home`}><Logo /></a>
    <nav aria-label="Main" class="ml-6 hidden md:block">
      <ul class="flex items-center gap-1">
        {
          site.nav.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined} class="rounded-lg px-3 py-2 text-sm font-medium text-ink-soft hover:text-ink aria-[current=page]:text-brand">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle />
      <a href={site.cta.href} class="hidden rounded-full bg-brand px-4 py-2 text-sm font-semibold text-on-brand hover:bg-brand-strong sm:inline-block">{site.cta.label}</a>
      <details class="mobile-menu relative md:hidden">
        <summary class="flex size-9 cursor-pointer list-none items-center justify-center rounded-full text-ink-soft hover:bg-brand-soft hover:text-ink" aria-label="Menu">
          <Icon name="menu" size={20} />
        </summary>
        <nav aria-label="Main (mobile)" class="absolute right-0 mt-2 w-56 rounded-(--radius-card) border border-line bg-paper p-2 shadow-lg">
          <ul>
            {
              site.nav.map((l) => (
                <li>
                  <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined} class="block rounded-lg px-3 py-2 text-ink hover:bg-brand-soft aria-[current=page]:text-brand">
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-1 border-t border-line pt-1">
              <a href={site.cta.href} class="block rounded-lg px-3 py-2 font-semibold text-brand hover:bg-brand-soft">{site.cta.label}</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
</style>
