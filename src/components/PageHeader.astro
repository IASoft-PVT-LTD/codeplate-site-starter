---
// The top of an inner page: an optional small label, the <h1> and an intro.
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
}
const { title, intro, eyebrow } = Astro.props;
---

<div class="mx-auto max-w-3xl px-4 pt-16 pb-10 text-center sm:px-6">
  {eyebrow && <p class="mb-3 text-sm font-semibold tracking-wide text-brand uppercase">{eyebrow}</p>}
  <h1 class="text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">{title}</h1>
  {intro && <p class="mx-auto mt-4 max-w-2xl text-lg text-pretty text-ink-soft">{intro}</p>}
  <slot />
</div>
