---
// /thanks/: where a form lands when the browser posts it without JavaScript.
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank you" description="We received your message." noindex>
  <PageHeader title="Thank you!" intro="We received it and will be in touch soon.">
    <p class="mt-8"><a href="/" class="rounded-full bg-brand px-6 py-3 font-semibold text-on-brand hover:bg-brand-strong">Back to the home page</a></p>
  </PageHeader>
</BaseLayout>
