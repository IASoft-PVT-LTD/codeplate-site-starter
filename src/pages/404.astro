---
// The "not found" page. Static hosts serve dist/client/404.html for unknown URLs.
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogUrl } from '../lib/blog';
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <PageHeader eyebrow="404" title="We couldn’t find that page." intro="It may have moved, or the link may be mistyped.">
    <p class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-brand px-6 py-3 font-semibold text-on-brand hover:bg-brand-strong">Home page</a>
      <a href={blogUrl()} class="rounded-full border border-line bg-paper px-6 py-3 font-semibold hover:border-brand hover:text-brand">Read the blog</a>
    </p>
  </PageHeader>
</BaseLayout>
