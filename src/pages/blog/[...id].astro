---
// /blog/<id>/: one post. The id is the file name in src/content/blog/
// (a post in a subfolder gets a nested URL, hence the rest parameter).
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Callout from '../../components/Callout.astro';
import { formatDate, postUrl, readingMinutes, tagLabel, tagUrl } from '../../lib/blog';
import { getPosts, type Post } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    // getPosts() is newest first: the next-newer post is before this one.
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags, cover, coverAlt } = post.data;
const author = await getEntry(post.data.author);
if (!author) throw new Error(`${post.id}: unknown author "${post.data.author.id}" (add it to src/content/authors.json)`);
const { Content } = await render(post);
---

<BaseLayout title={title} description={description} article={{ published: date, updated, author: author.data.name, tags }}>
  <article class="mx-auto max-w-3xl px-4 pt-16 sm:px-6">
    <header class="text-center">
      <p class="text-sm text-ink-soft">
        <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingMinutes(post.body ?? '')} min read
      </p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg text-ink-soft">{description}</p>
      <p class="mt-6 text-sm">
        By <span class="font-semibold">{author.data.url ? <a href={author.data.url} class="hover:text-brand">{author.data.name}</a> : author.data.name}</span>, {author.data.role}
      </p>
    </header>
    {cover && <Image src={cover} alt={coverAlt ?? ''} width={1200} class="mt-10 h-auto w-full rounded-(--radius-card) border border-line" loading="eager" />}
    <div class="prose mx-auto mt-10">
      <Content components={{ Callout }} />
    </div>
    {updated && <p class="mx-auto mt-10 max-w-[68ch] text-sm text-ink-soft">Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>.</p>}
    {
      tags.length > 0 && (
        <p class="mx-auto mt-8 flex max-w-[68ch] flex-wrap gap-2 text-sm">
          {tags.map((t) => (
            <a href={tagUrl(t)} class="rounded-full bg-brand-soft px-3 py-1 font-medium text-brand hover:underline">
              {tagLabel(t)}
            </a>
          ))}
        </p>
      )
    }
    <nav aria-label="More posts" class="mx-auto mt-12 grid max-w-[68ch] gap-4 border-t border-line pt-8 sm:grid-cols-2">
      {
        older ? (
          <a href={postUrl(older.id)} class="rounded-xl border border-line bg-paper p-4 hover:border-brand">
            <span class="block text-xs text-ink-soft">Older</span>
            <span class="font-semibold">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a href={postUrl(newer.id)} class="rounded-xl border border-line bg-paper p-4 text-right hover:border-brand">
            <span class="block text-xs text-ink-soft">Newer</span>
            <span class="font-semibold">{newer.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
