---
// /pricing/: the plans from src/data/pricing.ts.
import Faq from '../components/home/Faq.astro';
import PageHeader from '../components/PageHeader.astro';
import PricingTable from '../components/PricingTable.astro';
import { pricingFaq, pricingNote, pricingPage } from '../data/pricing';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pricing" description={pricingPage.description}>
  <PageHeader eyebrow={pricingPage.eyebrow} title={pricingPage.title} intro={pricingPage.intro} />
  <PricingTable />
  <p class="mx-auto mt-8 max-w-2xl px-4 text-center text-sm text-ink-soft">{pricingNote}</p>
  <Faq title="Pricing questions" items={pricingFaq} />
</BaseLayout>
