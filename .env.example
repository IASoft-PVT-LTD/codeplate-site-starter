# Copy to .env for development (never commit .env files). Everything here is
# optional: with no .env the site runs and the forms print to the server log.
# On a host, set these in its dashboard instead. They're declared, with their
# types, in `env.schema` in astro.config.mjs.

# --- Forms (src/pages/api/subscribe.ts, docs/recipes/connect-the-form.md) -------
# Where waitlist and contact form submissions go:
#   console  print them in the server log (development and the checks)
#   webhook  POST them as JSON to FORM_WEBHOOK_URL (Slack, Discord, Zapier, Make…)
FORM_PROVIDER=console
# The webhook URL for FORM_PROVIDER=webhook. Secret: anyone with it can post to your channel.
FORM_WEBHOOK_URL=
